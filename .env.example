# ==============================================================================
# CANGREJO — Environment Configuration Template (.env.example)
# Copy this file to .env (`cp .env.example .env`) for local or production setup.
# ==============================================================================

# 1. Standalone Bun.serve Production Host & SQLite Vault Persistence
NODE_ENV=development
CANGREJO_HOST=127.0.0.1
CANGREJO_PORT=3000
# Set to a file path (e.g. ./data/cangrejo_vault.sqlite or /data/cangrejo_vault.sqlite)
# for persistent WAL storage, or leave as :memory: for ephemeral in-memory mode.
CANGREJO_SQLITE_PATH=:memory:

# 2. Commercial Edition HMAC-SHA256 License Verification Secret (Gate 8)
CANGREJO_LICENSE_SECRET=

# 3. Cloudflare Workers AI & Vectorize Edge Integration (Gates 9 & 10)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_GATEWAY_SLUG=

# 4. Optional BYOK Commercial OSINT Provider API Keys (Gate 8)
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

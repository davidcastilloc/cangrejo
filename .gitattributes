# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source Code & Config
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.wgsl text eol=lf
*.xsd text eol=lf

# Binary Assets & Archives
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
*.cgrx binary
*.mtgx binary
*.zip binary

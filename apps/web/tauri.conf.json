{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cangrejo",
  "version": "1.0.0",
  "identifier": "org.cangrejo.osint.workstation",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CANGREJO — OSINT & Forensic Link-Analysis Workstation",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://crt.sh https://rdap.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "../../docs/brand/cangrejo_logo_emblem.png"
    ]
  }
}

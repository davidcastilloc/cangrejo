{
  "name": "@cangrejo/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CANGREJO — High-Performance Open-Source OSINT & Forensic Link-Analysis Graph Platform (inspired by Venezuela's Cangrejo de Oro criminalistics heritage)",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:bun": "bun test",
    "test:watch": "vitest",
    "test:gate0": "bun test tests/gate0-foundations.test.ts",
    "test:gate1": "bun test tests/gate1-graph-engine.test.ts",
    "test:gate2": "bun test tests/gate2-renderer-layout.test.ts",
    "test:gate3": "bun test tests/gate3-transforms-formats.test.ts",
    "moon:projects": "moon projects",
    "moon:check": "moon run :typecheck :test",
    "moon:ci": "moon ci"
  },
  "packageManager": "bun@1.4.3",
  "devDependencies": {
    "@moonrepo/cli": "^2.6.5",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
